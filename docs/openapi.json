{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Calories API",
    "description": "Food recognition and nutrition analysis",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ingredients": {
      "get": {
        "summary": "Get Ingredients",
        "operationId": "get_ingredients_ingredients_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IngredientResponse"
                  },
                  "type": "array",
                  "title": "Response Get Ingredients Ingredients Get"
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{recipe_id}": {
      "get": {
        "summary": "Get Recipe Endpoint",
        "operationId": "get_recipe_endpoint_recipes__recipe_id__get",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Recipe Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{recipe_id}/calculate": {
      "post": {
        "summary": "Calculate Recipe Endpoint",
        "operationId": "calculate_recipe_endpoint_recipes__recipe_id__calculate_post",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Recipe Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculateRecipeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict Food Endpoint",
        "description": "Recognize food from an uploaded image.\n\nReturns Top-K predictions from EfficientNet-B0.\n\nDoes not estimate portion weight or nutrition.",
        "operationId": "predict_food_endpoint_predict_post",
        "parameters": [
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5,
              "minimum": 1,
              "default": 3,
              "title": "Top K"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_predict_food_endpoint_predict_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/foods/by-canonical/{canonical_id}": {
      "get": {
        "summary": "Get Food By Canonical Id",
        "description": "Map model canonical ID to food and recipe candidates.\n\nDoes not automatically calculate nutrition.",
        "operationId": "get_food_by_canonical_id_foods_by_canonical__canonical_id__get",
        "parameters": [
          {
            "name": "canonical_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Canonical Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_predict_food_endpoint_predict_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_predict_food_endpoint_predict_post"
      },
      "CalculateRecipeRequest": {
        "properties": {
          "components": {
            "items": {
              "$ref": "#/components/schemas/IngredientPortion"
            },
            "type": "array",
            "minItems": 1,
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "components"
        ],
        "title": "CalculateRecipeRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngredientPortion": {
        "properties": {
          "ingredient_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Ingredient Id"
          },
          "grams": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Grams"
          }
        },
        "type": "object",
        "required": [
          "ingredient_id",
          "grams"
        ],
        "title": "IngredientPortion"
      },
      "IngredientResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name_vi": {
            "type": "string",
            "title": "Name Vi"
          },
          "name_en": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name En"
          },
          "preparation_state": {
            "type": "string",
            "title": "Preparation State"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name_vi",
          "name_en",
          "preparation_state"
        ],
        "title": "IngredientResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
